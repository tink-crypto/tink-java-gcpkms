load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

java_binary(
    name = "signature_example",
    srcs = ["SignatureExample.java"],
    main_class = "signature.SignatureExample",
    deps = [
        "@maven//:com_google_api_gax",
        "@maven//:com_google_api_grpc_proto_google_cloud_kms_v1",
        "@maven//:com_google_auth_google_auth_library_oauth2_http",
        "@maven//:com_google_cloud_google_cloud_kms",
        "@tink_java//src/main/java/com/google/crypto/tink:public_key_sign",
        "@tink_java//src/main/java/com/google/crypto/tink:public_key_verify",
        "@tink_java_gcpkms//src/main/java/com/google/crypto/tink/integration/gcpkms:gcp_kms_public_key_sign",
        "@tink_java_gcpkms//src/main/java/com/google/crypto/tink/integration/gcpkms:gcp_kms_public_key_verify",
    ],
)

# In order to run this test, use your own Cloud KMS key and credential
sh_test(
    name = "signature_example_test",
    size = "small",
    srcs = ["signature_example_test.sh"],
    args = [
        "$(rootpath :signature_example)",
        # Change this to your asymmetric-sign CryptoKeyVersion
        "projects/tink-test-infrastructure/locations/global/keyRings/unit-and-integration-testing/cryptoKeys/signature-key/cryptoKeyVersions/1",
        # Change this to your credential
        "$(rootpath //testdata/gcp:credential.json)",
        # Change this to your public key
        "$(rootpath //testdata/gcp:signature_key_public.pem)",
    ],
    data = [
        ":signature_example",
        # Change this to your credential
        "//testdata/gcp:credential.json",
        # Change this to your public key
        "//testdata/gcp:signature_key_public.pem",
    ],
    tags = [
        "manual",
        "requires-network",
    ],
)
